  "keyFeatures": [
    "1,300+ content packs covering security integrations, playbooks, and scripts",
    "Python and JavaScript integration framework with BaseClient HTTP abstraction",
    "Visual playbook engine (COPS format) for SOC automation",
    "CommandResults / return_results() pattern for structured output and context",
    "DBotScore standard for threat intelligence indicator scoring",
    "Incident fetching and mirroring between XSOAR and third-party platforms",
    "Docker-based isolated execution environment for integrations and scripts",
    "demisto-sdk CLI for linting, formatting, validation, and testing",
    "Supports xsoar, xsiam, xpanse, and platform marketplaces",
    "CommonServerPython runtime library injected into every integration"
  ],
  "publicApiSurface": [
    "BaseClient._http_request(method, url_suffix, ...)",
    "CommandResults(outputs_prefix, outputs, readable_output, ...)",
    "return_results(CommandResults)",
    "return_error(message)",
    "demisto.command()",
    "demisto.args()",
    "demisto.params()",
    "demisto.debug() / demisto.info()",
    "tableToMarkdown(name, t, headers, ...)",
    "DBotScoreType / DBotScoreReliability",
    "FeedIndicatorType",
    "IndicatorsTimeline",
    "EntityRelationship",
    "ScheduledCommand",
    "auto_detect_indicator_type(indicator_value)",
    "handle_proxy() / skip_cert_verification()",
    "demisto-sdk pre-commit -i <path>",
    "demisto-sdk validate -i <path>",
    "demisto-sdk format -i <path>"
  ]
}
